{
  // markdownlint rules for the Verity docs (mdBook source).
  // https://github.com/DavidAnson/markdownlint/blob/main/doc/Rules.md
  "default": true,
  "MD013": false, // line length — prose, tables, and links run long
  "MD033": false, // inline HTML — mdBook themes and mermaid blocks rely on it
  "MD041": false, // first line need not be an H1 (mdBook supplies page titles)
  "MD060": false, // table pipe spacing — compact tables are fine
  // Frontmatter `title:` is stripped by docs/preprocessors/strip-frontmatter.py before
  // rendering, so it is metadata, not a heading — don't count it as the page H1.
  "MD025": { "front_matter_title": "" },
  "MD036": false // bold lead-in labels (e.g. **Crates Verity must build itself**) are intentional
}
